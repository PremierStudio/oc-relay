{
  "name": "oc-relay",
  "version": "0.0.0-development",
  "description": "Declarative environments + cross-machine session relay for OpenCode",
  "type": "module",
  "license": "MIT",
  "author": "PremierStudio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PremierStudio/oc-relay.git"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "relay",
    "handoff",
    "worktree",
    "tailscale",
    "devcontainer"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "overrides": {
    "undici": "^8.10.0",
    "qs": "^6.15.3",
    "ip-address": "^10.5.0",
    "tar": "^7.5.22"
  },
  "files": [
    "dist",
    "bin",
    ".opencode/command"
  ],
  "bin": {
    "relay": "./bin/relay.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run coverage",
    "demo": "node demo/demo.mjs",
    "demo:record": "node demo/hero-tty.mjs && node demo/render-gif.mjs demo/hero.session.jsonl demo/demo.gif",
    "test:e2e": "npm run build && node --test \"test/e2e/*.test.mjs\"",
    "build": "tsup src/index.ts --format esm --dts --clean",
    "mutate": "stryker run"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^26.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@xterm/headless": "^6.1.0-beta.302",
    "canvas": "^3.2.3",
    "semantic-release": "^25.0.9",
    "tsup": "^8.5.1",
    "typescript": "~5.9.0",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "canvas@3.2.3": true
  }
}
