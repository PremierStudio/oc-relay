{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-js/master/packages/api/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "coverageAnalysis": "perTest",
  "reporters": ["clear-text", "progress", "html"],
  "mutate": ["src/index.ts", "src/manifest/**/*.ts", "src/provision/**/*.ts", "!src/**/*.test.ts"],
  "thresholds": {
    "high": 100,
    "low": 99,
    "break": 100
  },
  "excludedMutators": ["StringLiteral"],
  "concurrency": 4,
  "htmlReporter": {
    "fileName": "reports/mutation/mutation.html"
  }
}
